# Copy to .env for local development: cp .env.example .env
# The values below match the throwaway containers in the README.
# Every project reads only the variables with its own prefix.

NODE_ENV=development
# The host's port. Render sets it in production.
PORT=4400

# --- CollabCode (/collabcode) ----------------------------------------------
COLLAB_DATABASE_URL=postgresql://postgres:local@127.0.0.1:55432/collabcode
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COLLAB_JWT_SECRET=
COLLAB_JWT_EXPIRES_IN=7d
# The frontend's origin: CORS, Socket.io and the auth cookie all accept only this one.
COLLAB_CLIENT_ORIGIN=http://localhost:5177

# --- Pulse Monitor (/pulse) ------------------------------------------------
# In production a role of its own whose search_path is the "pulse" schema.
PULSE_DATABASE_URL=postgresql://pulse:pulse@127.0.0.1:55432/supa
PULSE_DATABASE_SSL=false
PULSE_JWT_SECRET=
# The frontend's origin: CORS, the CSRF origin check and the links in reset emails.
PULSE_APP_URL=http://localhost:5174
# Without a key, reset emails are written to the log instead of sent.
PULSE_RESEND_API_KEY=
PULSE_EMAIL_FROM=Pulse Monitor <onboarding@resend.dev>
# true: create the demo account if it is missing. reset: rebuild it on every start.
PULSE_SEED_DEMO=true
PULSE_CHECK_CONCURRENCY=10
PULSE_RUN_SCHEDULER=true

# --- Workflow Automation Engine (/workflow) --------------------------------
WORKFLOW_DATABASE_URL=postgresql://postgres:local@127.0.0.1:55432/supa
WORKFLOW_DATABASE_SSL=false
WORKFLOW_REDIS_URL=redis://127.0.0.1:56379
WORKFLOW_QUEUE_PREFIX=wae
WORKFLOW_JWT_SECRET=
# Comma-separated origins allowed by CORS.
WORKFLOW_FRONTEND_URL=http://localhost:5176
# Without a key, the email node simulates delivery and says so in the trace.
WORKFLOW_RESEND_API_KEY=
WORKFLOW_EMAIL_FROM=Workflow Engine <onboarding@resend.dev>
WORKFLOW_WORKER_CONCURRENCY=2
WORKFLOW_EXECUTION_TIMEOUT_MS=300000
WORKFLOW_MAX_ATTEMPTS_CAP=3
WORKFLOW_MAX_ACTIVE_EXECUTIONS_PER_USER=5
