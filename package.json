{
    "name": "api-joao-caetano",
    "private": true,
    "description": "One Express service that hosts the backends of João Caetano's portfolio projects under api.joao-caetano.com/<project>.",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "node --env-file-if-exists=.env --watch-path=src src/index.js",
        "start": "node --max-old-space-size=384 src/index.js",
        "build": "node scripts/build.js",
        "lint": "oxlint src scripts",
        "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\""
    },
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.3.0",
        "socket.io": "^4.8.4"
    },
    "devDependencies": {
        "oxlint": "^1.90.0",
        "prettier": "^3.9.10"
    }
}
