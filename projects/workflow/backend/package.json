{
    "name": "backend",
    "version": "2.0.0",
    "private": true,
    "main": "dist/mount.js",
    "type": "commonjs",
    "scripts": {
        "prebuild": "tsc -p ../shared/tsconfig.json",
        "build": "tsc -p tsconfig.build.json",
        "migrate": "tsx src/db/migrate.ts",
        "migrate:prod": "node dist/db/migrate.js",
        "seed": "tsx src/db/seed.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@wae/shared": "*",
        "bcrypt": "^6.0.0",
        "bullmq": "^6.3.9",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.2.0",
        "@types/pg": "^8.23.1",
        "pino-pretty": "*",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    }
}
